<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/techfix_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/pServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/techfix_text_primary"/>

        <TextView
            android:id="@+id/pBranchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/techfix_text_secondary"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/pAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textColor="@color/techfix_primary"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pPayButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Pay Now"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/techfix_primary"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/pPaidBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Paid"
            android:textColor="@color/techfix_success"
            android:textStyle="bold"
            android:paddingVertical="8dp"
            android:visibility="gone"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>