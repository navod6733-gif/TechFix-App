<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/techfix_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payments"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/techfix_text_primary"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/noPaymentsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No repairs awaiting payment."
        android:textColor="@color/techfix_text_secondary"
        android:textAlignment="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/paymentRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</LinearLayout>